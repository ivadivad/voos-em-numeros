model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Medidas", "dim_calendario", "dim_grupo", "dim_empresa", "dim_aeroporto", "dim_mercado", "mercado_mes", "validacao", "fusao", "pontualidade_rota", "pontualidade_horario", "Simular fusão", "Corte de atraso"]

ref table 'Corte de atraso'
ref table dim_aeroporto
ref table dim_calendario
ref table dim_empresa
ref table dim_grupo
ref table dim_mercado
ref table fusao
ref table Medidas
ref table mercado_mes
ref table pontualidade_horario
ref table pontualidade_rota
ref table 'Simular fusão'
ref table validacao

