	column cidade_b
		dataType: string
		lineageTag: b828372a-7bb0-5293-b7ed-05e58f28ac77
		summarizeBy: none
		sourceColumn: cidade_b

		annotation SummarizationSetBy = Automatic

	column nome_cidade_b
		dataType: string
		lineageTag: eba57e04-c94d-5b57-97ee-e5677e486a07
