	column nome
		dataType: string
		lineageTag: c60de842-1f2a-5278-bfbe-2ed61045d53c
		summarizeBy: none
		sourceColumn: nome

		annotation SummarizationSetBy = Automatic

	column distancia_km
		dataType: double
		formatString: #,0.0
		lineageTag: 5bba6b27-5ee8-5da8-ba1c-ac6435b5388b
		summarizeBy: none
		sourceColumn: distancia_km

		annotation SummarizationSetBy = Automatic

	column distancia_fonte
		dataType: string
		lineageTag: 30e13f71-c5d7-596d-9768-e615c6a923be
		summarizeBy: none
		sourceColumn: distancia_fonte

		annotation SummarizationSetBy = Automatic

	column 'faixa de distância' =
			SWITCH(
			    TRUE(),
			    ISBLANK(dim_mercado[distancia_km]), "sem distância",
			    dim_mercado[distancia_km] <= 500, "até 500 km",
			    dim_mercado[distancia_km] <= 1000, "500 a 1.000 km",
			    dim_mercado[distancia_km] <= 2000, "1.000 a 2.000 km",
			    "acima de 2.000 km"
			)
		dataType: string
		lineageTag: 7676c712-2517-55d9-9f5a-83b31b95bb4e
		summarizeBy: none
		sortByColumn: 'ordem da faixa'

		annotation SummarizationSetBy = Automatic

	column 'ordem da faixa' =
			SWITCH(
			    TRUE(),
			    ISBLANK(dim_mercado[distancia_km]), 5,
			    dim_mercado[distancia_km] <= 500, 1,
			    dim_mercado[distancia_km] <= 1000, 2,
			    dim_mercado[distancia_km] <= 2000, 3,
			    4
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e8028aae-f571-532f-804c-2d45b11e4adf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_mercado = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(Binary.Buffer(Web.Contents("https://raw.githubusercontent.com/ivadivad/voos-em-numeros/main/dados/marts/", [RelativePath = "dim_mercado.parquet"]))),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"mercado", type text}, {"cidade_a", type text}, {"nome_cidade_a", type text}, {"cidade_b", type text}, {"nome_cidade_b", type text}, {"nome", type text}, {"distancia_km", type number}, {"distancia_fonte", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

