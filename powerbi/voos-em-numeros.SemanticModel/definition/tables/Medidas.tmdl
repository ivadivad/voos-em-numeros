table Medidas
	lineageTag: f9d71573-7f02-5fd3-850b-5d87d2cf3758

	/// Passageiros pagos de voo regular, do grupo que operou (base estatística da ANAC). O passageiro é o do voo: quem troca de avião conta uma vez em cada voo.
	measure Passageiros = SUM(mercado_mes[passageiros_pagos])
		formatString: #,0
		displayFolder: Mercado
		lineageTag: 9454a7b1-823b-5a94-8622-2e25c0d9abb6

	/// Assentos vendidos nas tarifas registradas, pelo grupo que vendeu, no mês da venda.
	measure 'Assentos vendidos' = SUM(mercado_mes[assentos_vendidos])
		formatString: #,0
		displayFolder: Mercado
		lineageTag: 9b5dc302-fa26-59b8-8a0e-33a402ce7f9d

	/// Soma de tarifa vezes assentos vendidos, em reais nominais.
	measure Receita = SUM(mercado_mes[receita])
		formatString: R$ #,0
		displayFolder: Mercado
		lineageTag: 577a4c6c-47ea-5e19-9c42-3ac0aa83fcc8

	/// Receita dividida pelos assentos vendidos: a média ponderada pelos assentos, como a ANAC calcula.
	measure 'Tarifa média' = DIVIDE([Receita], [Assentos vendidos])
		formatString: R$ #,0.00
		displayFolder: Mercado
		lineageTag: fa784790-67fa-51c1-abfc-84f107e12ce9

	/// Receita dividida pelos assentos-km, só nos mercados com distância: a receita de quem não tem distância fica fora do numerador e do denominador.
	measure 'Tarifa por km' =
			DIVIDE(
			    CALCULATE([Receita], KEEPFILTERS(NOT ISBLANK(mercado_mes[assentos_km]))),
			    SUM(mercado_mes[assentos_km])
			)
		formatString: R$ #,0.000
		displayFolder: Mercado
		lineageTag: 08d5a513-e992-594f-b32d-92f2d9c48214

	/// Voos domésticos regulares de passageiros com partida prevista no VRA: realizados, cancelados e com situação NÃO INFORMADO.
	measure 'Voos previstos' = SUM(pontualidade_rota[voos_previstos])
		formatString: #,0
		displayFolder: Pontualidade
		lineageTag: c7a165d3-73e1-5da6-9abe-24df9460101b

	/// Voos que chegaram mais de 15 minutos depois do previsto, sobre os voos realizados com o atraso medido.
	measure '% atraso' = DIVIDE(SUM(pontualidade_rota[voos_atraso_15]), SUM(pontualidade_rota[voos_medidos]))
		formatString: 0.0%
		displayFolder: Pontualidade
		lineageTag: 29219ec3-a04b-5c61-b343-083cbc21fda2

	/// Voos cancelados sobre os realizados mais os cancelados. Os de situação NÃO INFORMADO ficam fora da conta.
	measure '% cancelado' =
			VAR cancelados = SUM(pontualidade_rota[voos_cancelados])
			RETURN DIVIDE(cancelados, SUM(pontualidade_rota[voos_realizados]) + cancelados)
		formatString: 0.0%
		displayFolder: Pontualidade
		lineageTag: a25b5826-d89b-57e7-a9f9-585bb0754722

	/// Índice Herfindahl-Hirschman do mercado no período: 10.000 vezes a soma dos quadrados das participações dos grupos nos passageiros regulares. Vazio fora de um mercado só.
	measure 'HHI sem fusão' =
			VAR total = CALCULATE([Passageiros], REMOVEFILTERS(dim_grupo))
			RETURN
			    IF(
			        HASONEVALUE(dim_mercado[mercado]) && total > 0,
			        10000 * SUMX(
			            ALL(dim_grupo[grupo]),
			            VAR g = dim_grupo[grupo]
			            RETURN DIVIDE(CALCULATE([Passageiros], REMOVEFILTERS(dim_grupo), dim_grupo[grupo] = g), total) ^ 2
			        )
			    )
		formatString: #,0
		displayFolder: Concentração
		lineageTag: 2227aa4f-d23b-5df6-99ef-75974b0819e1

	/// O mesmo HHI com Azul e GOL somadas num grupo só (o grupo_simulado): a fusão que não aconteceu, numa simulação estática, sem reação de ninguém.
	measure 'HHI com fusão' =
			VAR total = CALCULATE([Passageiros], REMOVEFILTERS(dim_grupo))
			RETURN
			    IF(
			        HASONEVALUE(dim_mercado[mercado]) && total > 0,
			        10000 * SUMX(
			            ALL(dim_grupo[grupo_simulado]),
			            VAR g = dim_grupo[grupo_simulado]
			            RETURN DIVIDE(CALCULATE([Passageiros], REMOVEFILTERS(dim_grupo), dim_grupo[grupo_simulado] = g), total) ^ 2
			        )
			    )
		formatString: #,0
		displayFolder: Concentração
		lineageTag: 53dff91c-9f25-56ba-8e61-174eebc8e1a7

	/// O HHI sem ou com a fusão, conforme o botão Simular fusão (sem seleção, sem fusão).
	measure HHI = IF(SELECTEDVALUE('Simular fusão'[Opção], "Não") = "Sim", [HHI com fusão], [HHI sem fusão])
		formatString: #,0
		displayFolder: Concentração
		lineageTag: a3100658-2ea8-5908-9f23-d62622ac5d13

	/// HHI com a fusão menos o HHI sem: 2 × 10.000 × a participação da Azul × a da GOL.
	measure 'Variação do HHI' = IF(NOT ISBLANK([HHI sem fusão]), [HHI com fusão] - [HHI sem fusão])
		formatString: #,0
		displayFolder: Concentração
		lineageTag: 22878327-272c-59fa-b4a7-f475724ed0ce

	/// A faixa da seção 2.4.2 do guia de concentração horizontal do CADE (2016), pelo HHI com a fusão e pela variação, com as mesmas fronteiras do sql/60_mart_fusao.sql.
	measure 'Leitura do guia do CADE' =
			VAR depois = [HHI com fusão]
			VAR delta = [Variação do HHI]
			RETURN
			    IF(
			        NOT ISBLANK(depois),
			        SWITCH(
			            TRUE(),
			            delta < 100, "variação pequena",
			            depois < 1500, "mercado não concentrado",
			            depois <= 2500 && delta > 100, "potencial preocupação",
			            depois > 2500 && delta <= 200, "potencial preocupação",
			            depois > 2500, "presunção de poder de mercado",
			            "sem leitura no guia"
			        )
			    )
		displayFolder: Concentração
		lineageTag: 8d2274c5-d496-5ae4-b005-c03749f7a748

	/// 1 quando a leitura do guia com a fusão é potencial preocupação ou presunção de poder de mercado, as duas leituras que o notebook 04 chama de cruzar a linha; vazio nos outros casos.
	measure 'Cruza a linha do CADE' = IF([Leitura do guia do CADE] IN {"potencial preocupação", "presunção de poder de mercado"}, 1)
		formatString: 0
		displayFolder: Concentração
		lineageTag: b86cbf79-168e-52dc-b0f2-abe09ce81427

	/// Mercados com passageiro pago de voo regular no período: os que têm HHI.
	measure 'Mercados com passageiro regular' = COUNTROWS(FILTER(VALUES(dim_mercado[mercado]), [Passageiros] > 0))
		formatString: #,0
		displayFolder: Concentração
		lineageTag: 92fbe00e-b859-5427-b0d3-3307041e1907

	/// Mercados em que a fusão Azul + GOL cairia numa das duas leituras do guia do CADE que pedem atenção, no período filtrado.
	measure 'Mercados que cruzariam a linha' = COUNTROWS(FILTER(VALUES(dim_mercado[mercado]), [Cruza a linha do CADE] = 1))
		formatString: #,0
		displayFolder: Concentração
		lineageTag: 6b46b2ef-3ef9-5c28-9c21-f6cfbf76e8f6

	/// Passageiros pagos de voo regular dos mercados que cruzariam a linha, sobre os de todos os mercados do período.
	measure '% dos passageiros nos que cruzariam' =
			DIVIDE(
			    SUMX(FILTER(VALUES(dim_mercado[mercado]), [Cruza a linha do CADE] = 1), [Passageiros]),
			    CALCULATE([Passageiros], REMOVEFILTERS(dim_mercado))
			)
		formatString: 0.0%
		displayFolder: Concentração
		lineageTag: 4acfdc55-7ba9-5923-bf26-9a94602de384

	/// Voos que chegaram atrasados além do corte escolhido no filtro Corte de atraso (15, 30 ou 60 minutos; sem escolha, 15), sobre os voos com atraso medido. Por aeroporto, é o de partida.
	measure '% atraso (corte)' =
			VAR corte = SELECTEDVALUE('Corte de atraso'[Minutos], 15)
			VAR atrasados =
			    SWITCH(
			        corte,
			        30, SUM(pontualidade_rota[voos_atraso_30]),
			        60, SUM(pontualidade_rota[voos_atraso_60]),
			        SUM(pontualidade_rota[voos_atraso_15])
			    )
			RETURN DIVIDE(atrasados, SUM(pontualidade_rota[voos_medidos]))
		formatString: 0.0%
		displayFolder: Pontualidade
		lineageTag: edafb85a-4dc3-5796-b4d6-91fd06a9d49b

	/// O mesmo atraso pelo aeroporto de chegada: liga o relacionamento inativo do destino.
	measure '% atraso chegando (corte)' = CALCULATE([% atraso (corte)], USERELATIONSHIP(pontualidade_rota[destino], dim_aeroporto[icao]))
		formatString: 0.0%
		displayFolder: Pontualidade
		lineageTag: 5f1cd67f-2e09-5a86-a86a-33daa325d2cc

	/// O atraso pelo corte escolhido, contado no mart por dia da semana e hora da partida prevista (horário de Brasília): o do mapa de calor.
	measure '% atraso por horário (corte)' =
			VAR corte = SELECTEDVALUE('Corte de atraso'[Minutos], 15)
			VAR atrasados =
			    SWITCH(
			        corte,
			        30, SUM(pontualidade_horario[voos_atraso_30]),
			        60, SUM(pontualidade_horario[voos_atraso_60]),
			        SUM(pontualidade_horario[voos_atraso_15])
			    )
			RETURN DIVIDE(atrasados, SUM(pontualidade_horario[voos_medidos]))
		formatString: 0.0%
		displayFolder: Pontualidade
		lineageTag: 31414ffd-b01f-56b8-bb1e-9fd0bb14afd3

	column Coluna
		dataType: string
		isHidden
		lineageTag: bc8e636b-4155-5fc5-8807-f1c4da368282
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Coluna = text], {})
				in
				    Fonte

	annotation PBI_ResultType = Table

